{
  "name": "@0xdeafcafe/tslsp-cli",
  "version": "0.1.0",
  "description": "Type-aware TypeScript code intelligence CLI — rename, references, definitions, hover, symbols, diagnostics, call hierarchy, code actions. Backed by tsgo.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdeafcafe/tslsp-cli.git"
  },
  "homepage": "https://github.com/0xdeafcafe/tslsp-cli#readme",
  "bugs": {
    "url": "https://github.com/0xdeafcafe/tslsp-cli/issues"
  },
  "keywords": [
    "typescript",
    "tsgo",
    "lsp",
    "cli",
    "claude",
    "claude-code",
    "rename",
    "refactor"
  ],
  "license": "MIT",
  "bin": {
    "tslsp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260506.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@vitest/ui": "^4.1.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.3"
}
