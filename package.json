{
  "name": "@0xdeafcafe/tslsp-cli",
  "version": "0.6.0",
  "description": "Type-aware TypeScript code intelligence CLI — rename, references, definitions, hover, symbols, diagnostics, call hierarchy, code actions. Backed by tsgo.",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "lsp",
    "refactor",
    "rename",
    "tsgo",
    "typescript"
  ],
  "homepage": "https://github.com/0xdeafcafe/tslsp-cli#readme",
  "bugs": {
    "url": "https://github.com/0xdeafcafe/tslsp-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdeafcafe/tslsp-cli.git"
  },
  "bin": {
    "tslsp-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "evals": "node --experimental-strip-types --no-warnings=ExperimentalWarning evals/run-skill-evals.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260506.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-node": "^0.218.0",
    "@types/node": "^24.13.2",
    "@vitest/ui": "^4.1.8",
    "langwatch": "^0.32.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "protobufjs": ">=8.0.2"
    }
  }
}
